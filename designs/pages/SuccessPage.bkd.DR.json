                        {
                            "_key": "html",
                            "_value": "<div style=\"max-width:500px; margin:20px auto; border:1px solid #d9e9d9; border-radius:8px; background:#ffffff; box-shadow:0 2px 8px rgba(0,0,0,0.08); font-family:Arial,sans-serif; overflow:hidden;\"\r\n*ngIf=\"page.result?.success; else elseBlock\"\r\n>\r\n\r\n    <!-- Success Header -->\r\n    <div style=\"background:#eaf8ea; color:#2e7d32; padding:12px; text-align:center; font-size:18px; font-weight:bold; border-bottom:1px solid #d9e9d9;\">\r\n        <img src=\"https://cdn-icons-png.flaticon.com/512/7518/7518748.png\"\r\n             alt=\"success-image\"\r\n             style=\"width:22px;height:22px;vertical-align:middle;margin-right:8px;\">\r\n        Claim Registered Successfully!\r\n    </div>\r\n\r\n    <!-- Claim Details -->\r\n    <div style=\"padding:18px;\">\r\n\r\n        <!-- <div style=\"display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f0f0f0;\">\r\n            <span style=\"font-weight:bold;color:#555;\">Claim ID</span>\r\n            <span>{{page.result?.data?.claimId}}</span>\r\n        </div>\r\n\r\n        <div style=\"display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f0f0f0;\">\r\n            <span style=\"font-weight:bold;color:#555;\">Status</span>\r\n            <span>{{page.result?.data?.status}}</span>\r\n        </div>\r\n\r\n        <div style=\"display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f0f0f0;\">\r\n            <span style=\"font-weight:bold;color:#555;\">Indicative Net Payable (₹)</span>\r\n            <span>₹ {{page.result?.data?.netPayable}}</span>\r\n        </div>\r\n\r\n        <div style=\"display:flex;justify-content:space-between;padding:8px 0;\">\r\n            <span style=\"font-weight:bold;color:#555;\">SLA</span>\r\n            <span>{{page.result?.data?.sla}} Hours</span>\r\n        </div> -->\r\n        <div style=\"display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f0f0f0;\">\r\n    <span style=\"font-weight:bold;color:#555;\">Claim ID</span>\r\n    <span>{{page.result?.data?.claimId}}</span>\r\n</div>\r\n\r\n<div style=\"display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f0f0f0;\">\r\n    <span style=\"font-weight:bold;color:#555;\">Status</span>\r\n    <span>REGISTERED</span>\r\n</div>\r\n\r\n<div style=\"display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f0f0f0;\">\r\n    <span style=\"font-weight:bold;color:#555;\">Indicative Net Payable (₹)</span>\r\n    <span>₹ {{page.result?.netPayable ?? 0}}</span>\r\n</div>\r\n\r\n<div style=\"display:flex;justify-content:space-between;padding:8px 0;\">\r\n    <span style=\"font-weight:bold;color:#555;\">SLA</span>\r\n    <span>24 Hours</span>\r\n</div>\r\n\r\n    </div>\r\n\r\n    <!-- Footer -->\r\n    <div style=\"text-align:center;padding:15px;\">\r\n       <button\r\n    style=\"background:#6a1b9a;color:#fff;border:none;padding:10px 24px;border-radius:5px;font-size:14px;cursor:pointer;\"\r\n    onclick=\"window.location.reload();\">\r\n    Go to Dashboard\r\n</button>\r\n    </div>\r\n\r\n</div>\r\n\r\n<ng-template #elseBlock>\r\n        <div style=\"background:#fdecea; color:#c62828; padding:12px; text-align:center; font-size:18px; font-weight:bold; border-bottom:1px solid #f5c6cb;\">\r\n        ❌ Claim Registration Failed\r\n    </div>\r\n\r\n    <div style=\"padding:18px; text-align:center;\">\r\n\r\n        <p style=\"margin:0; color:#555;\">\r\n            {{ page.result?.message || 'Unable to register claim. Please try again.' }}\r\n        </p>\r\n\r\n    </div>\r\n\r\n    <div style=\"text-align:center;padding:15px;\">\r\n        <button\r\n            style=\"background:#d32f2f;color:#fff;border:none;padding:10px 24px;border-radius:5px;font-size:14px;cursor:pointer;\"\r\n           onclick=\"window.location.reload()\"\r\n           >\r\n            Try Again\r\n        </button>\r\n    </div>\r\n</div>\r\n</ng-template>",
                            "_type": "a",
                            "_attrDef": "p"
                        }
                    ]
